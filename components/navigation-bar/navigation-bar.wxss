.nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 999;
  background: linear-gradient(180deg, #0b1b3a, #12275a);
  color: #fff;
  transition: opacity .3s ease;
}
.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back {
  position: absolute;
  left: 24rpx;
  font-size: 52rpx;
  line-height: 1;
}
.nav-title {
  font-size: 32rpx;
  letter-spacing: 4rpx;
}