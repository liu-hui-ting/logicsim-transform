.form-container {
  min-height: 100vh;
  background: #0b1b3a;
  color: #fff;
  padding: 40rpx 40rpx 60rpx;
  box-sizing: border-box;
}
.title { font-size: 44rpx; font-weight: bold; text-align: center; margin-top: 20rpx; }
.subtitle { font-size: 26rpx; color: #9fb0d0; text-align: center; margin-top: 16rpx; margin-bottom: 50rpx; }
.input-group { margin-bottom: 32rpx; }
.label { font-size: 28rpx; color: #d8c9a3; margin-bottom: 12rpx; }
.input {
  height: 80rpx;
  line-height: 80rpx;
  background: rgba(255,255,255,.08);
  border: 1rpx solid rgba(255,255,255,.15);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #fff;
}
.picker { color: #fff; }
.bottom-bar { display: flex; gap: 20rpx; margin-top: 60rpx; }
.btn-cancel, .btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 0;
}
.btn-cancel { background: rgba(255,255,255,.1); color: #fff; }
.btn-confirm { background: #d8c9a3; color: #0b1b3a; }
.btn-confirm[disabled] { opacity: .5; }