.schedule-page { padding: 40rpx; }
.tip {
  font-size: 26rpx;
  color: #d8c9a3;
  background: rgba(216,201,163,.12);
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
  line-height: 1.6;
}
.item { display: flex; position: relative; padding-bottom: 40rpx; }
.item::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: rgba(255,255,255,.15);
}
.item:last-child::before { display: none; }
.dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #d8c9a3;
  margin-right: 24rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
}
.time { font-size: 30rpx; color: #d8c9a3; font-weight: bold; }
.text { font-size: 30rpx; margin-top: 8rpx; }
.desc { font-size: 24rpx; color: #9fb0d0; margin-top: 8rpx; line-height: 1.6; }