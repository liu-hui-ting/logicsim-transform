.page { padding: 20rpx 40rpx 100rpx; }

/* 信封 */
.envelope {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  z-index: 1000; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: linear-gradient(180deg, #1b3a72, #0b1b3a);
  transition: opacity .6s ease, transform .6s ease;
}
.envelope.opened { opacity: 0; pointer-events: none; transform: scale(1.15); }
.envelope-flap {
  width: 0; height: 0;
  border-left: 280rpx solid transparent;
  border-right: 280rpx solid transparent;
  border-bottom: 180rpx solid #c2b48e;
  margin-bottom: -8rpx;
}
.envelope-body {
  width: 560rpx; height: 340rpx; background: #d8c9a3;
  border-radius: 12rpx; display: flex;
  align-items: center; justify-content: center;
}
.envelope-seal { font-size: 32rpx; color: #0b1b3a; font-weight: bold; }

/* 唱片 */
.record-wrap { position: relative; width: 380rpx; height: 380rpx; margin: 30rpx auto; }
.record {
  width: 380rpx; height: 380rpx; border-radius: 50%;
  background: radial-gradient(circle, #333 0%, #111 60%);
  box-shadow: 0 0 40rpx rgba(0,0,0,.6);
  animation: spin 12s linear infinite;
  position: relative;
}
.record.pause { animation-play-state: paused; }
.record-hole {
  position: absolute; top: 50%; left: 50%;
  width: 60rpx; height: 60rpx; margin: -30rpx 0 0 -30rpx;
  border-radius: 50%; background: #0b1b3a;
}
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.needle {
  position: absolute; top: -20rpx; right: 10rpx;
  width: 20rpx; height: 150rpx; background: #ccc; border-radius: 10rpx;
  transform-origin: top center; transform: rotate(-20deg);
  transition: transform .5s ease;
}
.needle-on { transform: rotate(10deg); }

.title { text-align: center; font-size: 52rpx; letter-spacing: 12rpx; margin-top: 20rpx; }
.sub { text-align: center; font-size: 30rpx; color: #d8c9a3; margin-top: 16rpx; }
.time { text-align: center; font-size: 26rpx; color: #9fb0d0; margin-top: 12rpx; }

/* 身份选择 */
.role-box { margin-top: 40rpx; }
.role-title { font-size: 28rpx; color: #9fb0d0; margin-bottom: 20rpx; text-align: center; }
.role-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 16rpx; }
.role-item {
  padding: 14rpx 32rpx; border-radius: 40rpx; font-size: 26rpx;
  background: rgba(255,255,255,.08); color: #cfd8ea;
  border: 1rpx solid rgba(255,255,255,.15);
}
.role-item.active {
  background: #d8c9a3; color: #0b1b3a; border-color: #d8c9a3;
}

/* 邀请语 */
.invite-card {
  margin: 32rpx 0; padding: 28rpx 32rpx;
  background: rgba(216,201,163,.12);
  border: 1rpx solid rgba(216,201,163,.3);
  border-radius: 16rpx;
}
.invite-label { font-size: 26rpx; color: #d8c9a3; margin-bottom: 12rpx; }
.invite-text { font-size: 28rpx; line-height: 1.8; color: #e6dfc9; }

/* 倒计时 */
.countdown { display: flex; justify-content: center; gap: 20rpx; margin: 40rpx 0; }
.cd-item {
  min-width: 100rpx; text-align: center; font-size: 36rpx;
  background: rgba(255,255,255,.1); border-radius: 12rpx; padding: 16rpx 0;
}
.cd-item text { font-size: 22rpx; margin-left: 6rpx; color: #9fb0d0; }

/* 按钮 */
.btn-main {
  height: 88rpx; line-height: 88rpx; text-align: center;
  border-radius: 44rpx; background: #d8c9a3; color: #0b1b3a;
  font-size: 32rpx; font-weight: bold;
}
.btn-ghost {
  margin-top: 24rpx; height: 88rpx; line-height: 88rpx; text-align: center;
  border-radius: 44rpx; background: rgba(255,255,255,.08); color: #fff;
  font-size: 32rpx; border: 1rpx solid rgba(255,255,255,.2);
}

.arrow-wrap { margin-top: 60rpx; text-align: center; }
.arrow {
  width: 30rpx; height: 30rpx; margin: 0 auto;
  border-left: 6rpx solid #d8c9a3; border-bottom: 6rpx solid #d8c9a3;
  transform: rotate(-135deg);
  animation: float 1.5s ease-in-out infinite;
}
.arrow-text { font-size: 24rpx; color: #9fb0d0; margin-top: 20rpx; }
@keyframes float {
  0%,100% { transform: rotate(-135deg) translate(0,0); }
  50% { transform: rotate(-135deg) translate(-12rpx,-12rpx); }
}

/* 区块 */
.section { padding: 60rpx 40rpx; background: #081428; }
.section-title { font-size: 36rpx; margin-bottom: 30rpx; color: #d8c9a3; }
.swiper { height: 400rpx; border-radius: 16rpx; overflow: hidden; }
.photo { width: 100%; height: 100%; }
.contact-row { padding: 24rpx 0; border-bottom: 1rpx solid rgba(255,255,255,.08); }
.text { font-size: 28rpx; color: #d8c9a3; }
.footer { text-align: center; font-size: 24rpx; color: #6b7ea0; padding: 40rpx 0 60rpx; background: #081428; }